class PianoPanel extends JPanel {

    // --- Layout size constants ---
    private static final int WHITE_KEY_WIDTH  = 40;
    private static final int WHITE_KEY_HEIGHT = 120;
    private static final int DUPLICATE_HEIGHT = 50;
    private static final int BLACK_KEY_WIDTH  = 26;
    private static final int BLACK_KEY_HEIGHT = 75;
    private static final int ROW_GAP          = 2;    // gap between original and duplicate rows

    // Which notes in an octave are black keys: C C# D D# E F F# G G# A A# B
    private static final boolean[] IS_BLACK_KEY = {
        false, true, false, true, false,
        false, true, false, true, false, true, false
    };
    private static final int NUMBER_OF_OCTAVES = 2;
    private static final int STARTING_NOTE     = 60; // Middle C in MIDI

    private final java.util.List<PianoKey> keyList = new java.util.ArrayList<>();
    private final SoundPlayer soundPlayer           = new SoundPlayer();
    private final PitchEngine pitchEngine           = new PitchEngine();
    private final PitchMeter  pitchMeter            = new PitchMeter();

    // ★ STUDENT CODE: boolean flag for invert mode ★
    private boolean invertMode = false;

    // Track which original and duplicate keys are currently held per note number
    private final boolean[] originalKeyHeld  = new boolean[128];
    private final boolean[] duplicateKeyHeld = new boolean[128];

    // ★ STUDENT CODE: JPanel used as a drawing surface for the keyboard ★
    private JPanel keyboardPanel;

    // Buttons and labels
    private JButton crankButton;
    private JButton pitchLockButton;
    private JButton invertButton;
    private JLabel  pitchLockStatus;

    public PianoPanel() {
        // ★ STUDENT CODE: BorderLayout divides panel into regions (NORTH, CENTER etc.) ★
        setLayout(new BorderLayout(10, 10));
        setBorder(BorderFactory.createEmptyBorder(12, 12, 12, 12));
        setBackground(new Color(30, 30, 30));

        buildKeys();
        add(buildControlPanel(),  BorderLayout.NORTH);
        add(buildKeyboardPanel(), BorderLayout.CENTER);

        // When pitch changes, update the meter display and the sound bend
        pitchEngine.addChangeListener(() -> {
            pitchMeter.setValue(pitchEngine.getPitch());
            soundPlayer.updatePitchBend(pitchEngine.getPitch());
        });
    }

    // ============================================================
    //  BUILD KEYS - Calculate screen positions for all keys
    // ============================================================
    private void buildKeys() {
        int whiteKeyIndex = 0;

        for (int octave = 0; octave < NUMBER_OF_OCTAVES; octave++) {
            for (int noteIndex = 0; noteIndex < 12; noteIndex++) {
                int noteNumber = STARTING_NOTE + octave * 12 + noteIndex;
                boolean isBlack = IS_BLACK_KEY[noteIndex];

                // --- ORIGINAL KEY ---
                PianoKey originalKey = new PianoKey(noteNumber, isBlack, false);
                if (!isBlack) {
                    int xPosition = whiteKeyIndex * WHITE_KEY_WIDTH;
                    originalKey.bounds = new Rectangle(xPosition, 0, WHITE_KEY_WIDTH - 1, WHITE_KEY_HEIGHT);
                    whiteKeyIndex++;
                } else {
                    // Black key sits between white keys
                    int previousWhiteIndex = whiteKeyIndex - 1;
                    int blackKeyX = previousWhiteIndex * WHITE_KEY_WIDTH + WHITE_KEY_WIDTH - BLACK_KEY_WIDTH / 2;
                    originalKey.bounds = new Rectangle(blackKeyX, 0, BLACK_KEY_WIDTH, BLACK_KEY_HEIGHT);
                }
                keyList.add(originalKey);

                // --- DUPLICATE KEY (sustain row, white keys only) ---
                if (!isBlack) {
                    PianoKey duplicateKey = new PianoKey(noteNumber, false, true);
                    int xPosition = (whiteKeyIndex - 1) * WHITE_KEY_WIDTH;
                    int yPosition = WHITE_KEY_HEIGHT + ROW_GAP;
                    duplicateKey.bounds = new Rectangle(xPosition, yPosition, WHITE_KEY_WIDTH - 1, DUPLICATE_HEIGHT);
                    keyList.add(duplicateKey);
                }
            }
        }
    }


