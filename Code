       import javax.swing.*;
import java.awt.*;
import java.awt.event.MouseAdapter;
import java.awt.event.MouseEvent;

public class PitchLockButton extends JButton {

    private final Color normalColor = new Color(0, 120, 0);
    private final Color hoverColor = new Color(0, 150, 0);

    private boolean isLocked = false;
    private final PitchEngine engine;

    public PitchLockButton(PitchEngine engine) {
        super("Pitch Lock");
        this.engine = engine;

        setFocusPainted(false);
        setBackground(normalColor);
        setForeground(Color.WHITE);
        setFont(getFont().deriveFont(Font.BOLD, 16f));

        addActionListener(e -> tryLockPitch());

        // Hover effects
        addMouseListener(new MouseAdapter() {
            @Override
            public void mouseEntered(MouseEvent e) {
                if (!isLocked) setBackground(hoverColor);
            }

            @Override
            public void mouseExited(MouseEvent e) {
                if (!isLocked) setBackground(normalColor);
            }
        });
    }

    private void tryLockPitch() {
        if (isLocked) return; // Already locked, do nothing

        isLocked = true;
        setEnabled(false);

        startCountdown();

        // Call engine lock
        engine.lockPitch(() -> {
            // When engine unlocks, UI unlock happens AFTER countdown finishes
            SwingUtilities.invokeLater(() -> {
                isLocked = false;
                setEnabled(true);
                setText("Pitch Lock");
                setBackground(normalColor);
            });
        });
    }

    private void startCountdown() {
        final int[] secondsLeft = {3};
        setText("Pitch Lock (" + secondsLeft[0] + ")");

        Timer countdownTimer = new Timer(1000, e -> {
            secondsLeft[0]--;

            if (secondsLeft[0] <= 0) {
                ((Timer) e.getSource()).stop();
                // Engine unlock callback will restore the button
            } else {
                setText("Pitch Lock (" + secondsLeft[0] + ")");
            }
        });

        countdownTimer.start();
    }
}
