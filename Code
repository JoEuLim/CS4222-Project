        import javax.swing.*;
import java.awt.*;
import java.awt.event.MouseAdapter;
import java.awt.event.MouseEvent;

public class InvertButton extends JButton {

    private boolean invertMode = false;

    private final Color normalColor = new Color(150, 90, 40);   // brown
    private final Color hoverColor = new Color(180, 120, 70);   // lighter brown

    private final Color onColor = new Color(255, 140, 0);       // orange
    private final Color onHoverColor = new Color(255, 170, 60); // lighter orange

    private final PianoPanel pianoPanel;

    public InvertButton(PianoPanel panel) {
        super("Invert");
        this.pianoPanel = panel;

        setFocusPainted(false);
        setBackground(normalColor);
        setForeground(Color.WHITE);
        setFont(getFont().deriveFont(Font.BOLD, 16f));

        addActionListener(e -> toggleInvert());

        // Hover effects
        addMouseListener(new MouseAdapter() {
            @Override
            public void mouseEntered(MouseEvent e) {
                if (invertMode) {
                    setBackground(onHoverColor);
                } else {
                    setBackground(hoverColor);
                }
            }

            @Override
            public void mouseExited(MouseEvent e) {
                if (invertMode) {
                    setBackground(onColor);
                } else {
                    setBackground(normalColor);
                }
            }
        });
    }

    private void toggleInvert() {
        invertMode = !invertMode;

        // Update button appearance
        if (invertMode) {
            setText("Invert ON");
            setBackground(onColor);
        } else {
            setText("Invert");
            setBackground(normalColor);
        }

        // Tell the piano panel to update its behaviour
        pianoPanel.setInvertMode(invertMode);

        // Refresh the keyboard drawing
        pianoPanel.repaint();
    }
}
