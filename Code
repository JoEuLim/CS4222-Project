import javax.swing.*;
import java.awt.*;
import java.awt.event.MouseAdapter;
import java.awt.event.MouseEvent;
import java.util.*;

public class PianoPanel extends JComponent {

    // White key order in an octave
    private static final String[] WHITE_NOTES = {
            "C", "D", "E", "F", "G", "A", "B"
    };

    // Black keys and their positions relative to white keys
    private static final String[] BLACK_NOTES = {
            "C#", "D#", "", "F#", "G#", "A#", ""
    };

    // State tracking
    private final Set<String> pressedKeys = new HashSet<>();
    private final Set<String> sustainedKeys = new HashSet<>();

    // Dimensions
    private static final int WHITE_KEY_WIDTH = 40;
    private static final int WHITE_KEY_HEIGHT = 180;

    private static final int BLACK_KEY_WIDTH = 25;
    private static final int BLACK_KEY_HEIGHT = 110;

    private static final int DUPLICATE_KEY_HEIGHT = 40;

    // External sound system (you will set this from outside)
    private SoundPlayer soundPlayer;

    // Invert mode
    private boolean invertMode = false;

    public PianoPanel() {
        setPreferredSize(new Dimension(
                WHITE_KEY_WIDTH * WHITE_NOTES.length,
                WHITE_KEY_HEIGHT + DUPLICATE_KEY_HEIGHT
        ));

        addMouseListener(new MouseAdapter() {

            @Override
            public void mousePressed(MouseEvent e) {
                handleMousePress(e.getX(), e.getY());
            }

            @Override
            public void mouseReleased(MouseEvent e) {
                handleMouseRelease(e.getX(), e.getY());
            }
        });
    }

    public void setSoundPlayer(SoundPlayer sp) {
        this.soundPlayer = sp;
    }

    public void setInvertMode(boolean invert) {
        this.invertMode = invert;
    }

    // ---------------------------
    // KEY STATE MANAGEMENT
    // ---------------------------

    private void pressKey(String note) {
        pressedKeys.add(note);
        repaint();
    }

    private void releaseKey(String note) {
        pressedKeys.remove(note);
        repaint();
    }

    private void sustainKey(String note) {
        sustainedKeys.add(note);
        repaint();
    }

    private void unsustainKey(String note) {
        sustainedKeys.remove(note);
        repaint();
    }

    // ---------------------------
    // HIT TESTING
    // ---------------------------

    private String hitTestBlack(int x, int y) {
        if (y > BLACK_KEY_HEIGHT) return null;

        for (int i = 0; i < BLACK_NOTES.length; i++) {
            String note = BLACK_NOTES[i];
            if (note.equals("")) continue;

            int keyX = i * WHITE_KEY_WIDTH + (WHITE_KEY_WIDTH - BLACK_KEY_WIDTH / 2);

            if (x >= keyX && x < keyX + BLACK_KEY_WIDTH) {
                return note;
            }
        }
        return null;
    }

    private String hitTestWhite(int x, int y) {
        if (y > WHITE_KEY_HEIGHT) return null;

        int index = x / WHITE_KEY_WIDTH;
        if (index >= 0 && index < WHITE_NOTES.length) {
            return WHITE_NOTES[index];
        }
        return null;
    }

    private String hitTestDuplicate(int x, int y) {
        if (y < WHITE_KEY_HEIGHT) return null;
        if (y > WHITE_KEY_HEIGHT + DUPLICATE_KEY_HEIGHT) return null;

        int index = x / WHITE_KEY_WIDTH;
        if (index >= 0 && index < WHITE_NOTES.length) {
            return WHITE_NOTES[index] + " dupli";
        }
        return null;
    }

    // ---------------------------
    // MOUSE BEHAVIOUR
    // ---------------------------

    private void handleMousePress(int x, int y) {

        // 1. Black keys first
        String note = hitTestBlack(x, y);
        if (note != null) {
            handleNormalKeyPress(note);
            return;
        }

        // 2. Duplicate keys
        note = hitTestDuplicate(x, y);
        if (note != null) {
            handleDuplicateKeyPress(note);
            return;
        }

        // 3. White keys
        note = hitTestWhite(x, y);
        if (note != null) {
            handleNormalKeyPress(note);
        }
    }

    private void handleMouseRelease(int x, int y) {

        // Determine which key was released
        String note = hitTestBlack(x, y);
        if (note == null) note = hitTestWhite(x, y);

        if (note == null) return;

        boolean isDuplicate = false;

        // Duplicate keys release differently
        String dupli = hitTestDuplicate(x, y);
        if (dupli != null) {
            note = dupli;
            isDuplicate = true;
        }

        if (invertMode) {
            // In invert mode:
            // - normal keys sustain
            // - duplicate keys behave normally
            if (!isDuplicate) {
                // normal key release does nothing (sustained)
                return;
            } else {
                // duplicate key release stops sound
                stopNote(note.replace(" dupli", ""));
                releaseKey(note);
            }
        } else {
            // Normal mode:
            // - normal keys behave normally
            // - duplicate keys sustain
            if (!isDuplicate) {
                // normal key release stops sound unless sustained
                String base = note;
                if (!sustainedKeys.contains(base)) {
                    stopNote(base);
                }
                releaseKey(base);
            } else {
                // duplicate key release does nothing (sustained)
                return;
            }
        }

        repaint();
    }

    // ---------------------------
    // KEY PRESS LOGIC
    // ---------------------------

    private void handleNormalKeyPress(String note) {
        String base = note;

        if (invertMode) {
            // In invert mode: normal keys sustain
            if (!sustainedKeys.contains(base)) {
                sustainKey(base);
                startNote(base);
            }
        } else {
            // Normal mode: normal keys play normally
            pressKey(base);
            startNote(base);
        }
    }

    private void handleDuplicateKeyPress(String dupliNote) {
        String base = dupliNote.replace(" dupli", "");

        boolean basePressed = pressedKeys.contains(base);
        boolean baseSustained = sustainedKeys.contains(base);

        if (invertMode) {
            // In invert mode: duplicate keys behave normally
            pressKey(dupliNote);
            startNote(base);
            return;
        }

        // Normal mode: duplicate keys sustain
        if (!basePressed && !baseSustained) {
            // Start sustain
            sustainKey(base);
            startNote(base);
        } else {
            // If already held, stop everything
            stopNote(base);
            unsustainKey(base);
            releaseKey(base);
        }
    }

    // ---------------------------
    // SOUND CONTROL
    // ---------------------------

    private void startNote(String note) {
        if (soundPlayer == null) return;

        int midi = noteToMidi(note);
        soundPlayer.startNote(midi, 100);
    }

    private void stopNote(String note) {
        if (soundPlayer == null) return;

        int midi = noteToMidi(note);
        soundPlayer.stopNote(midi);
    }

    // Simple mapping for one octave (you can expand later)
    private int noteToMidi(String note) {
        switch (note) {
            case "C": return 60;
            case "C#": return 61;
            case "D": return 62;
            case "D#": return 63;
            case "E": return 64;
            case "F": return 65;
            case "F#": return 66;
            case "G": return 67;
            case "G#": return 68;
            case "A": return 69;
            case "A#": return 70;
            case "B": return 71;
        }
        return 60;
    }

    // ---------------------------
    // PAINTING
    // ---------------------------

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);

        Graphics2D g2 = (Graphics2D) g.create();
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        // Draw white keys + duplicate keys
        for (int i = 0; i < WHITE_NOTES.length; i++) {
            String note = WHITE_NOTES[i];

            int x = i * WHITE_KEY_WIDTH;

            // Determine color
            if (pressedKeys.contains(note)) {
                g2.setColor(Color.BLUE);
            } else if (sustainedKeys.contains(note)) {
                g2.setColor(Color.ORANGE);
            } else {
                g2.setColor(Color.WHITE);
            }

            // Draw white key
            g2.fillRect(x, 0, WHITE_KEY_WIDTH, WHITE_KEY_HEIGHT);
            g2.setColor(Color.BLACK);
            g2.drawRect(x, 0, WHITE_KEY_WIDTH, WHITE_KEY_HEIGHT);

            // Duplicate key
            String dupli = note + " dupli";

            if (pressedKeys.contains(dupli)) {
                g2.setColor(Color.BLUE);
            } else if (sustainedKeys.contains(note)) {
                g2.setColor(Color.ORANGE);
            } else {
                g2.setColor(new Color(220, 220, 255));
            }

            g2.fillRect(x, WHITE_KEY_HEIGHT, WHITE_KEY_WIDTH, DUPLICATE_KEY_HEIGHT);
            g2.setColor(Color.BLACK);
            g2.drawRect(x, WHITE_KEY_HEIGHT, WHITE_KEY_WIDTH, DUPLICATE_KEY_HEIGHT);

            // Draw note name
            g2.setColor(Color.BLACK);
            g2.setFont(getFont().deriveFont(Font.BOLD, 12f));

            FontMetrics fm = g2.getFontMetrics();
            int textWidth = fm.stringWidth(note);

            g2.drawString(note, x + (WHITE_KEY_WIDTH - textWidth) / 2, WHITE_KEY_HEIGHT - 5);

            // Duplicate label
            String dupliLabel = note + " dupli";
            textWidth = fm.stringWidth(dupliLabel);

            g2.drawString(dupliLabel, x + (WHITE_KEY_WIDTH - textWidth) / 2,
                    WHITE_KEY_HEIGHT + DUPLICATE_KEY_HEIGHT - 5);
        }

        // Draw black keys on top
        for (int i = 0; i < BLACK_NOTES.length; i++) {
            String note = BLACK_NOTES[i];
            if (note.equals("")) continue;

            int x = i * WHITE_KEY_WIDTH + (WHITE_KEY_WIDTH - BLACK_KEY_WIDTH / 2);

            if (pressedKeys.contains(note)) {
                g2.setColor(Color.BLUE);
            } else if (sustainedKeys.contains(note)) {
                g2.setColor(Color.ORANGE);
            } else {
                g2.setColor(Color.BLACK);
            }

            g2.fillRect(x, 0, BLACK_KEY_WIDTH, BLACK_KEY_HEIGHT);
            g2.setColor(Color.BLACK);
            g2.drawRect(x, 0, BLACK_KEY_WIDTH, BLACK_KEY_HEIGHT);
        }

        g2.dispose();
    }
}

