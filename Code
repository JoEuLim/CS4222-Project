 // COPILOT GENERATED - Pitch Engine

public class PitchEngine {

    private int pitch = 0;
    private final Timer decayTimer;
    private final Random random = new Random();
    private final List<PitchObserver> observers = new ArrayList<>();

    public PitchEngine() {
        // Decay timer: runs every 100ms
        decayTimer = new Timer(100, e -> {
            if (pitch > 0) {
                pitch--;
                notifyObservers();
            }
        });
        decayTimer.start();
    }

    public int getPitch() {
        return pitch;
    }

    // Normalized for UI components like PitchMeter (0–1000)
    public int getPitchNormalized() {
        return Math.min(1000, Math.max(0, pitch));
    }

    public void increasePitch() {
        int amount = random.nextInt(100) + 1; // 1–100
        pitch += amount;
        notifyObservers();
    }

    public void lockPitch(Runnable onUnlock) {
        decayTimer.stop();

        // Timer that waits 3 seconds, then resumes decay
        new Timer(3000, e -> {
            decayTimer.start();
            if (onUnlock != null) {
                onUnlock.run();
            }
            ((Timer) e.getSource()).stop();
        }).start();
    }

    public void addObserver(PitchObserver observer) {
        observers.add(observer);
    }

    public void removeObserver(PitchObserver observer) {
        observers.remove(observer);
    }

    private void notifyObservers() {
        for (PitchObserver obs : observers) {
            obs.onPitchChanged(pitch);
        }
    }

    // Observer interface
    public interface PitchObserver {
        void onPitchChanged(int newPitch);
    }
}


// COPILOT GENERATED - Pitch Meter
public class PitchMeter extends JComponent implements PitchEngine.PitchObserver {

    private int value = 0; // 0–1000

    public PitchMeter() {
        setPreferredSize(new Dimension(60, 200));
    }

    @Override
    public void onPitchChanged(int newPitch) {
        // Convert engine pitch to 0–1000 range
        int normalized = Math.max(0, Math.min(1000, newPitch));
        setValue(normalized);
    }

    public void setValue(int value) {
        this.value = Math.max(0, Math.min(1000, value));
        repaint();
    }

    public int getValue() {
        return value;
    }

    @Override
    protected void paintComponent(Graphics g) {
        super.paintComponent(g);

        Graphics2D g2 = (Graphics2D) g.create();
        g2.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);

        int width = getWidth();
        int height = getHeight();

        // Background
        g2.setColor(Color.DARK_GRAY);
        g2.fillRect(0, 0, width, height);

        // Determine bar color
        Color barColor;
        if (value < 400) {
            barColor = new Color(0, 180, 0); // green
        } else if (value < 700) {
            barColor = new Color(255, 140, 0); // orange
        } else {
            barColor = new Color(200, 0, 0); // red
        }

        // Compute bar height
        double pct = value / 1000.0;
        int barHeight = (int) (pct * height);

        // Draw bar from bottom
        g2.setColor(barColor);
        g2.fillRect(0, height - barHeight, width, barHeight);

        // Draw value text centered inside bar
        g2.setColor(Color.WHITE);
        g2.setFont(getFont().deriveFont(Font.BOLD, 16f));

        String text = String.valueOf(value);
        FontMetrics fm = g2.getFontMetrics();
        int textWidth = fm.stringWidth(text);
        int textHeight = fm.getAscent();

        int textX = (width - textWidth) / 2;
        int textY = (height - barHeight) + (barHeight / 2) + (textHeight / 2);

        g2.drawString(text, textX, textY);

        g2.dispose();
    }
}

//  SOUND PLAYER - Copilot Generated

public class SoundPlayer {

    private Synthesizer synth;
    private MidiChannel channel;

    // Pitch bend range in MIDI is 0–16383 (8192 = center)
    private static final int PITCH_BEND_CENTER = 8192;
    private static final int PITCH_BEND_MAX = 16383;

    public SoundPlayer() {
        try {
            synth = MidiSystem.getSynthesizer();
            synth.open();

            // Use channel 0 (piano)
            channel = synth.getChannels()[0];

            // Set instrument to Acoustic Grand Piano (program 0)
            channel.programChange(0);

        } catch (Exception e) {
            System.err.println("Error initializing SoundPlayer: " + e.getMessage());
        }
    }

    /**
     * Start playing a note.
     * @param note MIDI note number (0–127)
     * @param volume 0–127
     */
    public void startNote(int note, int volume) {
        try {
            if (channel != null) {
                channel.noteOn(note, volume);
            }
        } catch (Exception e) {
            System.err.println("Error starting note: " + e.getMessage());
        }
    }

    /**
     * Stop playing a note.
     * @param note MIDI note number (0–127)
     */
    public void stopNote(int note) {
        try {
            if (channel != null) {
                channel.noteOff(note);
            }
        } catch (Exception e) {
            System.err.println("Error stopping note: " + e.getMessage());
        }
    }

    /**
     * Bend the pitch of the currently playing note(s).
     * @param amount 0 = normal pitch, 1000 = max bend (scaled internally)
     */
    public void bendPitch(int amount) {
        try {
            if (channel != null) {
                int clamped = Math.max(0, Math.min(1000, amount));

                // Scale 0–1000 → 8192–16383
                int bend = PITCH_BEND_CENTER + (int)((clamped / 1000.0) * (PITCH_BEND_MAX - PITCH_BEND_CENTER));

                channel.setPitchBend(bend);
            }
        } catch (Exception e) {
            System.err.println("Error bending pitch: " + e.getMessage());
        }
    }

    /**
     * Stop all sound and close the synthesizer.
     */
    public void shutdown() {
        try {
            if (channel != null) {
                channel.allNotesOff();
            }
            if (synth != null && synth.isOpen()) {
                synth.close();
            }
        } catch (Exception e) {
            System.err.println("Error shutting down SoundPlayer: " + e.getMessage());
        }
    }
}


