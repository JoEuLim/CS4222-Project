// --------------
// Sound Player (AI Generated)
//--------------
class SoundPlayer {

    private Synthesizer synth;
    private MidiChannel channel;

    public SoundPlayer() {
        try {
            synth = MidiSystem.getSynthesizer();
            synth.open();
            channel = synth.getChannels()[0];
            channel.programChange(0);
        } catch (Exception error) {
            error.printStackTrace();
        }
    }

    public void startNote(int noteNumber) {
        if (channel != null) channel.noteOn(noteNumber, 100);
    }

    public void stopNote(int noteNumber) {
        if (channel != null) channel.noteOff(noteNumber);
    }

    public void bendPitch(int pitchValue) {
        if (channel == null) return;
        int bendAmount = 8192 + (int)((pitchValue / 1000.0) * (16383 - 8192));
        bendAmount = Math.max(0, Math.min(16383, bendAmount));
        channel.setPitchBend(bendAmount);
    }

    public void close() {
        if (synth != null && synth.isOpen()) synth.close();
    }
}

// -------------
// Pitch Engine (AI generated)
// -------------
class PitchEngine {

    // ============================================================
    //  Copilot prompt:
    //  "Create a Java class called PitchEngine. It stores a number
    //   called pitch starting at zero. Every 100 milliseconds the
    //   pitch drops by 1 but never below zero. There is a method
    //   called increasePitch that adds a random number between 1 and
    //   100 to pitch. There is a method called lockPitch that stops
    //   the pitch from dropping for exactly 3 seconds then lets it
    //   resume. There is a method getPitch that returns the current
    //   pitch. There is a method isLocked that returns true if pitch
    //   is currently locked. Whenever pitch changes, call a
    //   registered listener."
    // ============================================================

    private int pitch  = 0;
    private boolean locked = false;
    private Listener listener;

    public PitchEngine() {
        new javax.swing.Timer(100, event -> {
            if (!locked && pitch > 0) {
                pitch--;
                notifyListener();
            }
        }).start();
    }

    public void increasePitch() {
        pitch = Math.min(1000, pitch + new Random().nextInt(101)); // cap at 1000 so decay is always visible
        notifyListener();
    }

    public void lockPitch() {
        locked = true;
        javax.swing.Timer unlockTimer = new javax.swing.Timer(3000, event -> {
            locked = false;
            notifyListener();
        });
        unlockTimer.setRepeats(false);
        unlockTimer.start();
    }

    public int getPitch()     { return pitch; }
    public boolean isLocked() { return locked; }

    public void setListener(Listener l) { listener = l; }

    private void notifyListener() {
        if (listener != null) listener.onChange(pitch);
    }

    interface Listener {
        void onChange(int value);
    }
}

// -------------
// Pitch Meter (AI Generated)
// -------------
class PitchMeter extends JComponent {

    // ============================================================
    //  Copilot prompt:
    //  "Create a Java class called PitchMeter that draws itself on
    //   screen as a vertical coloured bar. The bar grows upward based
    //   on a number between 0 and 1000. Green below 400, orange
    //   between 400 and 699, red at 700 or above. Show the number as
    //   text in the centre. The component is 60 pixels wide and
    //   200 pixels tall. There is a setValue method that updates
    //   the number and redraws the bar."
    // ============================================================

    private int currentValue = 0;

    public PitchMeter() {
        setPreferredSize(new Dimension(60, 200));
    }

    public void setValue(int newValue) {
        currentValue = Math.max(0, Math.min(1000, newValue));
        repaint();
    }

    protected void paintComponent(Graphics g) {
        super.paintComponent(g);
        int panelWidth  = getWidth();
        int panelHeight = getHeight();

        g.setColor(Color.DARK_GRAY);
        g.fillRect(0, 0, panelWidth, panelHeight);

        int barHeight = (int)((currentValue / 1000.0) * panelHeight);

        // Three in-tune green bands: 10-100, 250-350, 550-650
        // Everything else is yellow (out of tune) or red (very high)
        boolean inTune = (currentValue >= 10  && currentValue <= 100)
                      || (currentValue >= 250 && currentValue <= 350)
                      || (currentValue >= 550 && currentValue <= 650);
        if (inTune)                        g.setColor(new Color(60, 180, 60));   // green = in tune
        else if (currentValue < 900)       g.setColor(new Color(230, 160, 0));   // yellow = out of tune
        else                               g.setColor(new Color(200, 40, 40));   // red = very high

        g.fillRect(0, panelHeight - barHeight, panelWidth, barHeight);

        // Draw the number in the centre of the meter
        g.setColor(Color.WHITE);
        g.setFont(new Font("Arial", Font.BOLD, 13));
        String label = String.valueOf(currentValue);
        FontMetrics fontMetrics = g.getFontMetrics();
        g.drawString(label,
            (panelWidth - fontMetrics.stringWidth(label)) / 2,
            panelHeight / 2 + fontMetrics.getAscent() / 2);

        g.setColor(Color.GRAY);
        g.drawRect(0, 0, panelWidth - 1, panelHeight - 1);
    }
}
